# Copy to .env and customize before running compose.

POSTGRES_DB=protocol
POSTGRES_USER=protocol
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8787
WEB_PORT=3000
SCAFFOLD_DATA_DIR=/data/6x-protocol
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional API auth token. If set, all /api/v1/* routes require this key
# in `X-6X-API-Key` (or `Authorization: Bearer <token>`). Health endpoints stay open.
API_AUTH_TOKEN=
# Optional secret encryption key for at-rest JSON secrets in settings/integrations.
# You can set either:
# - a passphrase string (derived to a Fernet key), or
# - `fernet:<base64-urlsafe-32-byte-key>`
SECRET_ENCRYPTION_KEY=
# Optional managed secret adapter mode:
# - disabled (default)
# - env      (resolve `env:KEY` / `secret://env/KEY`)
# - file     (resolve `file:path.to.value` / `secret://file/path.to.value`)
# - chain    (allow both env and file references)
SECRET_PROVIDER_MODE=disabled
# Optional JSON secret file used when mode includes `file`.
SECRET_PROVIDER_FILE=/data/6x-protocol/managed-secrets.json
# Optional prefix when resolving env refs, e.g. SIXPX_SECRET_.
SECRET_PROVIDER_ENV_PREFIX=
# Optional HTTP JSON secret source used when mode includes `http`.
SECRET_PROVIDER_HTTP_URL=
SECRET_PROVIDER_HTTP_AUTH_TOKEN=
SECRET_PROVIDER_HTTP_TIMEOUT_SEC=3.0
SECRET_PROVIDER_HTTP_ALLOW_INSECURE=false
# Runtime image/version governance (GA hardening baseline)
SIXPX_IMAGE_TAG=local-dev
SIXPX_EXPECTED_IMAGE_TAG=local-dev
SIXPX_IMAGE_DIGEST=
SIXPX_RELEASE_CHANNEL=beta
SIXPX_BUILD_SHA=local
SIXPX_BUILD_DATE=
SIXPX_EXPECTED_API_VERSION=
SIXPX_MIN_API_VERSION=
SIXPX_MAX_API_VERSION=
SIXPX_MIN_STORE_SCHEMA_VERSION=1
SIXPX_MAX_STORE_SCHEMA_VERSION=3
