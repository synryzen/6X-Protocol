# Copy to .env and customize before running compose.

POSTGRES_DB=protocol
POSTGRES_USER=protocol
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8787
WEB_PORT=3000
SCAFFOLD_DATA_DIR=/data/6x-protocol
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional API auth token. If set, all /api/v1/* routes require this key
# in `X-6X-API-Key` (or `Authorization: Bearer <token>`). Health endpoints stay open.
API_AUTH_TOKEN=
# Optional secret encryption key for at-rest JSON secrets in settings/integrations.
# You can set either:
# - a passphrase string (derived to a Fernet key), or
# - `fernet:<base64-urlsafe-32-byte-key>`
SECRET_ENCRYPTION_KEY=
